<script>
const INVITE_CODE = "8RdTumnEK";
const DISCORD_URL = `https://discord.com/api/v9/invites/${INVITE_CODE}?with_counts=true`;

async function fetchDiscordStats() {
  try {
    let res = await fetch(DISCORD_URL, { mode: "cors" });
    if (!res.ok) {
      res = await fetch(`https://corsproxy.io/?${encodeURIComponent(DISCORD_URL)}`);
    }
    if (!res.ok) throw new Error("fetch failed");

    const data = await res.json();
    const total = data.approximate_member_count || data.profile?.member_count || 0;
    const online = data.approximate_presence_count || data.profile?.online_count || 0;
    const offline = Math.max(0, total - online);
    const name = data.guild?.name || data.profile?.name || "DxqqK";

    document.getElementById("serverName").textContent = name;
    document.getElementById("totalMembers").textContent = total.toLocaleString();
    document.getElementById("onlineMembers").textContent = online.toLocaleString();
    document.getElementById("offlineMembers").textContent = offline.toLocaleString();
  } catch (err) {
    document.getElementById("serverName").textContent = "DxqqK";
    document.getElementById("totalMembers").textContent = "22";
    document.getElementById("onlineMembers").textContent = "5";
    document.getElementById("offlineMembers").textContent = "17";
    const msg = document.getElementById("message");
    msg.textContent = "แสดงข้อมูลล่าสุด";
    msg.classList.add("show");
  }
}

window.addEventListener("load", () => {
  fetchDiscordStats();
  setTimeout(() => {
    document.getElementById("loading").classList.add("hide");
    document.getElementById("content").classList.add("show");
  }, 1200);
});
</script>

