<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DxqqK</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #08080c;
  color: white;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.bg {
  position: fixed;
  width: 320px;
  height: 320px;
  background: #762bff;
  filter: blur(150px);
  opacity: .22;
  top: 22%;
  left: 50%;
  transform: translateX(-50%);
}

#loading {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: #08080c;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20px;
  transition: opacity .7s, visibility .7s;
}

.loader {
  width: 38px;
  height: 38px;
  border: 3px solid #292431;
  border-top-color: #a66cff;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

#loading.hide {
  opacity: 0;
  visibility: hidden;
}

.content {
  position: relative;
  text-align: center;
  padding: 28px 22px;
  opacity: 0;
  transform: translateY(15px);
  transition: .8s ease;
  max-width: 420px;
  width: 100%;
}

.content.show {
  opacity: 1;
  transform: translateY(0);
}

.logo {
  font-size: 38px;
  font-weight: 800;
  letter-spacing: 4px;
  margin-bottom: 6px;
  background: linear-gradient(120deg, #fff, #a77aff);
  -webkit-background-clip: text;
  color: transparent;
}

.tagline {
  color: #85818f;
  font-size: 13px;
  margin-bottom: 26px;
}

/* Discord Card */
.discord-card {
  background: #12121a;
  border: 1px solid #2e2a3d;
  border-radius: 18px;
  padding: 20px 18px 18px;
  margin-bottom: 22px;
}

.discord-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 16px;
}

.discord-icon {
  width: 28px;
  height: 28px;
  background: #5865F2;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.discord-icon svg {
  width: 18px;
  height: 18px;
  fill: white;
}

.discord-title {
  font-size: 16px;
  font-weight: 600;
  color: #fff;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.stat {
  background: #1a1a24;
  border: 1px solid #2a2a38;
  border-radius: 12px;
  padding: 12px 14px;
  min-width: 84px;
}

.stat-value {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 3px;
}

.stat-label {
  font-size: 11px;
  color: #85818f;
}

.stat.total .stat-value { color: #a66cff; }
.stat.online .stat-value { color: #43b581; }
.stat.offline .stat-value { color: #747f8d; }

a.discord-btn {
  display: block;
  background: linear-gradient(135deg, #5865F2, #4752C4);
  color: white;
  padding: 13px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: .2s;
}

a.discord-btn:active {
  transform: scale(.96);
}

/* Socials */
.socials-title {
  font-size: 12px;
  color: #6b6775;
  margin-bottom: 12px;
  letter-spacing: 0.5px;
}

.socials {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

.social-btn {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: .2s;
  border: 1px solid #2a2a38;
  background: #12121a;
}

.social-btn:active {
  transform: scale(.92);
}

.social-btn svg {
  width: 22px;
  height: 22px;
}

.social-btn.ig { color: #E1306C; }
.social-btn.fb { color: #1877F2; }
.social-btn.line { color: #06C755; }
.social-btn.tiktok { color: #fff; }

#message {
  margin-top: 16px;
  color: #b994ff;
  font-size: 12px;
  opacity: 0;
  transition: .3s;
}

#message.show {
  opacity: 1;
}
</style>
</head>

